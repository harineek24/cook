# ── Backend (Express on Render) ──────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/cookdb?sslmode=require

# Comma-separated allowed origins for CORS (your Vercel frontend URL)
# Leave unset to allow all origins (fine for development)
ALLOWED_ORIGINS=https://your-app.vercel.app

# Port (Render sets this automatically)
PORT=3001

# ── Frontend (Vite on Vercel) ────────────────────────────────
# Set this in Vercel's environment variables
# Points to your Render backend URL
VITE_API_URL=https://cook-api.onrender.com
