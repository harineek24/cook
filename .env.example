# Neon PostgreSQL connection string (required)
# Get yours at https://neon.tech — create a free project, copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Pollinations API key (optional — enables AI image generation + ingredient recognition)
# Get yours at https://enter.pollinations.ai
POLLINATIONS_API_KEY=
